HOST=0.0.0.0
PORT=3000
PAN_PILOT_DEFAULT_MODEL_ID=volcengine/deepseek-v4-flash
# Bearer token for /v1/*. When configured, every /v1 request (including plugin
# mutations) requires it; when empty, all /v1 routes are open (no auth).
PAN_PILOT_API_TOKEN=
# Password used only by POST /v1/auth/login to issue a 30-day signed browser
# passport. Keep it in the runtime environment; never commit the real value.
# Only when BOTH the API token and this password are configured does the web
# console require login (non-dismissable dialog); local dev with no password
# shows no password prompt at all.
PAN_PILOT_CONSOLE_PASSWORD=
# Directory for controlled single-file code artifacts (created on first save).
# Production must point this at a release-external persistent directory.
PAN_PILOT_ARTIFACTS_DIR=./artifacts
# Declarative tool plugins directory; each plugin is a subdirectory with manifest.json.
PAN_PILOT_PLUGINS_DIR=./plugins
# Comma-separated host allowlist for http executor plugins (e.g. api.example.com).
# Default deny: if empty, http executor plugins are rejected at load and install.
PAN_PILOT_PLUGIN_ALLOWED_HOSTS=
# Comma-separated names of environment variables plugins may reference via ${env:NAME}.
# Default deny: if empty, any ${env:...} reference is rejected.
PAN_PILOT_PLUGIN_ALLOWED_ENV_VARS=
# Agent self-install switch for the install_plugin tool. Default off (fail-closed):
# the tool is exposed but every call is rejected until this is enabled.
PAN_PILOT_PLUGIN_AUTO_INSTALL=false
# Directory for uploaded media analyzed by analyze_image / analyze_audio /
# transcribe_audio tools (created on first upload).
PAN_PILOT_MEDIA_DIR=./media
# --- HostRuntime: filesystem + terminal (core, cannot be unloaded/shadowed) ---
# The fs_* and terminal tools are core HostRuntime capabilities registered
# directly (not plugin manifests), available to the whole host the service
# account can reach. Relative paths resolve against PAN_PILOT_HOST_CWD
# (default: the process working directory); absolute paths reach the whole host.
# Front control:
#   PAN_PILOT_FS_ENABLED=false      disable the fs_* tools entirely
#   PAN_PILOT_TERMINAL_ENABLED=false disable the terminal tool entirely
# Old PAN_PILOT_FS_ROOTS is kept as an ADMIN-LEVEL restriction: when set, fs
# tools only operate inside those roots (realpath-guarded, symlink-proof).
PAN_PILOT_HOST_CWD=
PAN_PILOT_FS_ENABLED=
PAN_PILOT_FS_ROOTS=
PAN_PILOT_TERMINAL_ENABLED=
# Comma-separated extra environment variable names the terminal tool may inherit
# (on top of PATH/HOME/USER/SHELL/LANG/TZ/tmp dirs). PanPilot API/model/passport
# keys are NEVER passed to child processes.
PAN_PILOT_TERMINAL_ENV_ALLOWLIST=
# Permission-gate guardrails:
#   Directory holding permanent permission rules + persisted task authorization
#   requests (atomic JSON). Default ./permissions.
PAN_PILOT_PERMISSIONS_DIR=
# Pending authorization request expiry (ms). Default 120000 (matches the tool
# timeout window). Per-request duration is also capped by the tool timeout.
PAN_PILOT_PERMISSION_REQUEST_TIMEOUT_MS=
# Extra sensitive-path glob rules appended to the built-in set (SSH/GPG/cloud/
# browser credentials/system keychains/.env/private keys). realpath-based.
# Comma-separated, or a JSON array of strings in PAN_PILOT_SENSITIVE_PATHS_FILE.
PAN_PILOT_SENSITIVE_PATHS=
PAN_PILOT_SENSITIVE_PATHS_FILE=
# Versioned scheduled-task state and run history. Production must point this at
# a release-external persistent directory.
PAN_PILOT_SCHEDULED_TASKS_DIR=./scheduled-tasks
# Directory for chat session history (created on first save). Production must
# point this at a release-external persistent directory.
PAN_PILOT_SESSIONS_DIR=./sessions
# Optional versioned MCP client config. When omitted, no MCP servers are connected.
PAN_PILOT_MCP_CONFIG=
# Logs complete messages and model replies. These records may contain private data.
PAN_PILOT_LOG_CHAT_CONTENT=false
# Default agent system prompt body injected into /v1/chat when the caller does not
# provide its own system message. Empty string disables injection entirely.
# Unset uses the built-in default (agent identity + current tool list).
PAN_PILOT_SYSTEM_PROMPT=
# Agent input context budget. When estimated tokens exceed the limit (or message
# count exceeds 80), older history is summarized while system and recent messages stay verbatim.
PAN_PILOT_CONTEXT_MAX_TOKENS=48000
PAN_PILOT_CONTEXT_TARGET_TOKENS=33600
PAN_PILOT_CONTEXT_RECENT_TOKENS=14400
PAN_PILOT_CONTEXT_SUMMARY_MAX_TOKENS=2000
PAN_PILOT_CONTEXT_MAX_MESSAGES=80
# Long-running chat execution feedback: per-model-call timeout, per-tool timeout,
# and the overall request timeout, all in milliseconds. Timeouts surface as
# MODEL_TIMEOUT / TOOL_TIMEOUT / REQUEST_TIMEOUT events instead of CHAT_FAILED.
PAN_PILOT_MODEL_TIMEOUT_MS=120000
PAN_PILOT_TOOL_TIMEOUT_MS=120000
PAN_PILOT_CHAT_TIMEOUT_MS=600000
# /v1/chat SSE route sends a heartbeat event on this interval and a SLOW_RESPONSE
# warning when no agent event has arrived within PAN_PILOT_SLOW_WARNING_MS.
PAN_PILOT_HEARTBEAT_INTERVAL_MS=5000
PAN_PILOT_SLOW_WARNING_MS=30000

# --- Image understanding (Volcengine Ark Coding Plan) ---
# Required only when media tools are used; the client is constructed lazily.
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# Optional DNS override for the Volcengine main-chat host only.
VOLCENGINE_CHAT_RESOLVED_ADDRESS=
# Exact model string; do not rewrite doubao-seed-2.1-turbo into a hyphenated form.
VOLCENGINE_MULTIMODAL_MODEL=doubao-seed-2.1-turbo

# --- Audio understanding (standard Ark; requires separate model activation) ---
# If empty, VOLCENGINE_API_KEY is reused. Coding Plan currently rejects input_audio.
VOLCENGINE_AUDIO_API_KEY=
VOLCENGINE_AUDIO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_AUDIO_MODEL=doubao-seed-2-0-lite-260428

# --- DeepSeek official main chat ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_RESOLVED_ADDRESS=
# Optional search endpoint override; defaults to Bing web search (no API key).
SEARCH_BASE_URL=
MIMO_API_KEY=

# Optional Java business-service endpoint for future tools.
JAVA_SERVICE_URL=
