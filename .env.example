HOST=0.0.0.0
PORT=3000
PAN_PILOT_API_TOKEN=
PAN_PILOT_DEFAULT_MODEL_ID=volcengine/deepseek-v4-flash
# Approval mutation endpoints (approve/reject/execute) fail closed with 503
# when this token is not configured; anonymous users can only create drafts.
# Directory for uploaded and edited .docx files (created on first upload).
PAN_PILOT_DOCS_DIR=./docs
# Declarative tool plugins directory; each plugin is a subdirectory with manifest.json.
PAN_PILOT_PLUGINS_DIR=./plugins
# Comma-separated host allowlist for http executor plugins (e.g. api.example.com).
# Default deny: if empty, http executor plugins are rejected at load and at draft creation.
PAN_PILOT_PLUGIN_ALLOWED_HOSTS=
# Comma-separated names of environment variables plugins may reference via ${env:NAME}.
# Default deny: if empty, any ${env:...} reference is rejected.
PAN_PILOT_PLUGIN_ALLOWED_ENV_VARS=
# Validity window (minutes) for self-service plugin approvals; default 15.
PAN_PILOT_PLUGIN_APPROVAL_TTL_MINUTES=15
# Directory for uploaded media analyzed by analyze_image / analyze_audio /
# transcribe_audio tools (created on first upload).
PAN_PILOT_MEDIA_DIR=./media
# Logs complete messages and model replies. These records may contain private data.
PAN_PILOT_LOG_CHAT_CONTENT=false

# --- Image understanding (Volcengine Ark Coding Plan) ---
# Required only when media tools are used; the client is constructed lazily.
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
# Optional DNS override for the Volcengine main-chat host only.
VOLCENGINE_CHAT_RESOLVED_ADDRESS=
# Exact model string; do not rewrite doubao-seed-2.1-turbo into a hyphenated form.
VOLCENGINE_MULTIMODAL_MODEL=doubao-seed-2.1-turbo

# --- Audio understanding (standard Ark; requires separate model activation) ---
# If empty, VOLCENGINE_API_KEY is reused. Coding Plan currently rejects input_audio.
VOLCENGINE_AUDIO_API_KEY=
VOLCENGINE_AUDIO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_AUDIO_MODEL=doubao-seed-2-0-lite-260428

# --- DeepSeek official main chat ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_RESOLVED_ADDRESS=
# Optional search endpoint override; defaults to Bing web search (no API key).
SEARCH_BASE_URL=
MIMO_API_KEY=

# Optional Java business-service endpoint for future tools.
JAVA_SERVICE_URL=
