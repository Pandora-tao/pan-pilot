{
  "apiVersion": "v1",
  "name": "transcribe_audio",
  "description": "将用户上传的音频（mediaId 来自 /v1/media 上传结果）中的语音逐字转写为文本，可选 language 指定目标语言；不能用于任意文件路径或远程 URL",
  "parameters": {
    "type": "object",
    "properties": {
      "mediaId": { "type": "string", "pattern": "^[a-zA-Z0-9-]+$" },
      "language": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "required": ["mediaId"],
    "additionalProperties": false
  },
  "executor": { "type": "builtin", "ref": "transcribe_audio" },
  "enabled": true
}
