{
  "apiVersion": "v1",
  "name": "analyze_image",
  "description": "分析用户上传的图片（mediaId 来自 /v1/media 上传结果），返回主体、文字、颜色等结构化描述；不能用于任意文件路径或远程 URL",
  "parameters": {
    "type": "object",
    "properties": {
      "mediaId": { "type": "string", "pattern": "^[a-zA-Z0-9-]+$" },
      "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "required": ["mediaId"],
    "additionalProperties": false
  },
  "executor": { "type": "builtin", "ref": "analyze_image" },
  "enabled": true
}
