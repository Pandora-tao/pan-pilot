{
  "apiVersion": "v1",
  "name": "edit_word_document",
  "description": "修改已上传的 Word 文档：替换文本或在指定段落后插入新段落；原件不变，返回修改后文件的下载地址",
  "parameters": {
    "type": "object",
    "properties": {
      "fileId": { "type": "string", "pattern": "^[a-zA-Z0-9-]+$" },
      "edits": {
        "minItems": 1,
        "maxItems": 10,
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "replace_text" },
                "oldText": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "newText": { "type": "string", "maxLength": 2000 }
              },
              "required": ["type", "oldText", "newText"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "type": { "type": "string", "const": "insert_paragraph" },
                "afterText": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "paragraph": { "type": "string", "minLength": 1, "maxLength": 5000 }
              },
              "required": ["type", "afterText", "paragraph"],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": ["fileId", "edits"],
    "additionalProperties": false
  },
  "executor": { "type": "builtin", "ref": "edit_word_document" },
  "enabled": true
}
