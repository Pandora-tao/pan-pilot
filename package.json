{
  "name": "pan-pilot",
  "version": "0.1.0",
  "private": true,
  "description": "A small TypeScript agent runtime for learning and experimentation.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/src/index.js",
    "test": "vitest run --dir test --passWithNoTests",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "docx": "^9.7.1",
    "fastify": "^5.10.0",
    "jszip": "^3.10.1",
    "openai": "^7.0.0",
    "undici": "^8.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
